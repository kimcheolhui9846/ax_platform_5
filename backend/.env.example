# 모델 제공자. mock(기본, 비용 0) 또는 claude(실제 호출, 비용 발생).
PROVIDER=mock
# PROVIDER=claude일 때: API 키는 이 파일이 아니라 환경 변수나 backend/.env에 ANTHROPIC_API_KEY로 넣는다(커밋 금지).
# 지금 넣는 키는 개발자 개인 키다 — 인수 시 폐기하고 인수 기업 키로 바꾼다(docs/HANDOFF.md "개인 계정·키·로컬 데이터").
# CLAUDE_MODEL=claude-opus-5-5   # 더 싸게: claude-sonnet-5-5, claude-haiku-5-5
# CLAUDE_EFFORT=medium           # low | medium | high | xhigh | max
# 단계별 라우팅(기본 꺼짐, JSON). 단계: diagnose, easier_question, propose_value, generate, validate
# 측정(docs/HARNESS-ROADMAP.md 0단계) 전에는 켜지 않는다. 예: 가벼운 단계는 Haiku, 생성은 노력 높이기
# CLAUDE_STAGE_MODELS={"diagnose":"claude-haiku-5-5","easier_question":"claude-haiku-5-5","propose_value":"claude-haiku-5-5"}
# CLAUDE_STAGE_EFFORTS={"generate":"high"}
# 주의: 빈 값(`CLAUDE_STAGE_MODELS=`)은 꺼짐이다. 단계 이름은 PROVIDER=mock이어도 시작 때 검사한다(틀리면 서버가 멈춘다).
# 모델 id 오타는 시작 때 잡히지 않는다(그 단계의 첫 호출이 502로 실패한다).
# Haiku로 보낸 단계는 거절 대체 모델(fallbacks)이 없고, 생성이 아닌 단계는 형식이 깨져도 다시 부르지 않는다.
# AI 동시 호출 상한(LLM·이미지 합쳐서, app/providers/limit.py). 자리를 대기 시간 안에 못 얻으면 503(세션은 그대로).
# AI_MAX_CONCURRENT_CALLS=4
# AI_QUEUE_WAIT_SECONDS=10
# true면 /sessions/{id}/trace 디버깅 엔드포인트를 연다. 기본값은 false이고, 로컬 개발에서는 켜 둔다.
DEBUG=true
# 세션 저장소. sqlite면 backend/data/sessions.db에 남아 서버를 다시 켜도 그대로다(테스트 기본값은 memory).
STORE=sqlite
# 결과 이미지 제공자. 지금은 mock(자리표시 SVG)만 지원한다.
IMAGE_PROVIDER=mock
# STORE=sqlite일 때 결과 이미지를 두는 폴더(기본 backend/data/assets). memory면 메모리에 둔다.
# ASSET_DIR=data/assets
