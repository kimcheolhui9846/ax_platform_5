# 모델 제공자. mock(기본, 비용 0) 또는 claude(실제 호출, 비용 발생).
PROVIDER=mock
# PROVIDER=claude일 때: API 키는 이 파일이 아니라 환경 변수나 backend/.env에 ANTHROPIC_API_KEY로 넣는다(커밋 금지).
# 지금 넣는 키는 개발자 개인 키다 — 인수 시 폐기하고 인수 기업 키로 바꾼다(docs/HANDOFF.md "개인 계정·키·로컬 데이터").
# CLAUDE_MODEL=claude-opus-5-5   # 더 싸게: claude-sonnet-5-5, claude-haiku-5-5
# CLAUDE_EFFORT=medium           # low | medium | high | xhigh | max
# true면 /sessions/{id}/trace 디버깅 엔드포인트를 연다. 기본값은 false이고, 로컬 개발에서는 켜 둔다.
DEBUG=true
# 세션 저장소. sqlite면 backend/data/sessions.db에 남아 서버를 다시 켜도 그대로다(테스트 기본값은 memory).
STORE=sqlite
# 결과 이미지 제공자. 지금은 mock(자리표시 SVG)만 지원한다.
IMAGE_PROVIDER=mock
# STORE=sqlite일 때 결과 이미지를 두는 폴더(기본 backend/data/assets). memory면 메모리에 둔다.
# ASSET_DIR=data/assets
